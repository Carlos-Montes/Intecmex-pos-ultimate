body
    background-color:  #f8f7fa;
    font-family: 'Public Sans', sans-serif !important;
    font-size: 14px
    margin: 0px
    padding: 0px

.wrapper
    display: flex
    height: 100vh
    max-height: 100vh
    width: 100%
    .sidebar
        background-color:  #081B33
        box-shadow: 0 0.125rem 0.25rem rgba(165,163,174 .3)
        height: 100%
        max-height: 100%
        transition: all 0.3 ease
        width: 260px
        z-index 999
        .logo
            padding: 16px 12px
            position: relative
            img
                display: block
                width: 90%
            a
                color: var(--label-white)
                font-size: 1.9em
                position: absolute
                top: 33px
                right: 5px
        ul 
            box-sizing: border-box
            display: block
            list-style: none
            margin: 0px
            overflow: hidden
            padding: 0px 12px
            transition: height 0.3s ease
            width: 100%
            li
                display: block
                margin-bottom: 2px
                width: 100%
                a   
                    color: var(--label-white)
                    border-radius: 2px
                    box-sizing: border-box
                    display: block
                    font-size: 1.12em
                    font-weight: 500
                    padding: 10px 16px
                    transition-duration: 0.2s
                    transition-property: none
                    text-decoration: none
                    width: 100%
                   &:hover
                        background-color: var(--button-primary)
                        border-radius: 2px
                    span.row-icon
                        font-size: 0.8em
                        margin-top: 4px
                        float: right
                        transition: all 0.2s ease
                a.active
                    background-color: var(--button-primary)
                    color: var(--label-white)
                    i
                        color: var(--label-white)
                ul 
                    background-color: var(--background-black)
                    display: none
                    padding: 0px
                    li
                        a
                            i 
                                color: var(--background-white)
                                font-size: 0.7em
                                position: relative
                                top: -2px
    .content
        box-sizing: border-box
        height: 100vh
        max-height: 100vh
        overflow: scroll
        padding: 24px
        width: calc(100% - 260px)
        .topbar
            display: flex
            background-color:  #081B33
            border-radius: 6px
            justify-content: space-between
            padding: 14px 16px
            width: 100%
            z-index 999
            ul 
                display: flex
                list-style none
                margin: 0px
                padding: 0px
                li
                    a
                        cursor: pointer
                        display: flex
                        width: 100%
                        i
                            display: block
                            color: var(--label-white)
                            font-size: 1.4em
                            max-height: 26px
                            width: 26px
                        &:hover
                            color: var(--button-primary)
                            i
                            span
                                color: var(--button-primary)
                &:last-child
                    li
                        position relative
                        margin-left: 12px
                        a
                            align-items: center
                            display: flex
                            color: var(--label-white)
                            font-size: 1.1em
                            justify-content: center
                            height: 100%
                            text-decoration: none
                            i
                                font-size: 1.2em !important
                            img
                                display: block
                                border: 50%
                                position relative
                                margin-top: -3px
                                width: 28px
                            span
                                margin-right: 6px
    .form-medium
        width: 180px
    .opts
        overflow hidden
        a
            align-items center
            display flex
            border-radius 8px
            cursor pointer
            font-size .9em
            float left
            justify-content center
            margin-right 8px
            height 38px
            width 38px
        a.edit
            background-color #FF4500 
            color #fff
        a.deleted
            background-color #922B21 
            color #fff
        a.inventory
            background-color: #008000
            color #fff
.mini-profile
    display: flex
    .avatar
        width 64px
        img
            display: block
            border-radius: 10px
            width 100%
    .header-info
        margin-left: 16px
        width calc(100% - 80)
        h5
            color: var(--button-primary)
            font-size: 1.375rem
            margin: 0px
            padding: 0px
        small
            display: flex
            color: var(--button-primary)
            width 100%

ul.pagination
    display: flex
    justify-content: flex-end
    margin: 0px
    .page-item
        margin-right: 4px
        &:last-child
            margin: 0px
        .page-link
            align-items: center
            background-color: rgba(75, 70, 92, .16)
            border: 0px
            color: var(--morado)
            display: flex
            border-radius: 4px
            font-size: 0.9375rem
            justify-content: center
            height: 32px
            width 32px
            &:hover
                background-color: rgba(75, 70, 92, .16)
                color: #5d596c
            &:focus
                box-shadow: none !important
                outline: none !important
    .active
        .page-link
            background-color: var(--morado) !important
            color: var(--blanco)
            &:hover
                background-color: var(--azul) !important
                color: var(--blanco)

.list-card-profile-avatar
    display: grid
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr))
    margin-top: 15px
    margin-bottom: 24px
    justify-content: flex-start
    gap 28px
    .card
        border: 0px
        box-sizing: border-box
        flex-basis: calc(25% - 21px)
        flex-direction: column
        transform: scale(1)
        transition: all 0.2s ease
        padding: 12px
        gap: 16px
        .actions
            display: flex
            border-top: 1px solid #f0f0f0
            justify-content: center
            list-style none
            margin-top: 3px
            padding-top: 3px
            ul 
                display: flex
                list-style none
                margin: 0px
                padding: 0px 
                width 100%
                li
                    display: flex
                    margin-right: 12px
                    a
                        display: flex
                        border-radius: 4px
                        color: var(--button-primary)
                        text-decoration: none
                        line-height: initial
                        padding: 8px 10px
                        i
                            line-height: initial
                            max-height: 19px
                            margin-right: 4px
                        &:hover
                            background-color: var(--button-primary)
                            color: var(--label-white)
        .body
            display: flex
            width 100%
            .avatar
                margin-right: 12px
                user-select: none
                width 48px
                .photo
                    align-items: center
                    border-radius: 50%
                    color: #fff
                    display: flex
                    overflow: hidden
                    justify-content: center
                    font-size: 1.2em
                    font-weight: bold
                    height: 48px
                    width 48px
                    img
                        display: block
                        width 100%
            .info
                flex: 1
                h5
                   color: var(--morado) !important
                   margin-bottom: 4px
                   font-size: 1.1em
                p
                    color: #000 !important
                    font-size: .9em
                    line-height: normal
                    margin-bottom: 1px
                    span.verified
                        color: #3897f0
                    span.danger
                        color: #ff0000  
            .avatar_1
                background-color: #4fae5a
            .avatar_2
                background-color: #8a6347
            .avatar_3
                background-color: #5a6a7f
            .avatar_4
                background-color: #6a7f5a
            .avatar_5
                background-color: #7f5a6a
            .avatar_6
                background-color: #2e86ab

.hide-in-desktop
    display: none

.panel
    background-color: #fff
    border-radius: 6px
    .panel-header
        border-bottom: 1px solid #dbdade
        h5
            color: var(--button-primary)
            font-size: 1.3em
            margin-bottom: 0px
            i
                color: var(--button-primary)
        ul
            display inline-block
            float right
            margin-right 12px
            li
                display inline-block
                position relative
                a
                    color #333
                    display inline-block
                    padding 10px
                    text-decoration: none
                    &:hover
                        background-color #f6f6f6
                        color #222
                        text-decoration none
                    i
                            color  #17202A
                ul
                    background-color #fff
                    border 1px solid #f0f0f0
                    display none
                    float none
                    position absolute
                    right -16px
                    width 200px
                    li
                        display inline-block
                        border-bottom 1px solid #f0f0f0
                        width 100%
                        &:last-child
                            border-bottom 0px
                        a
                            display block
                            width value
                            text-decoration: none
                &:hover
                    ul
                        display block
    .panel-body
        h2
            color: var(--button-primary)
            font-size: 1.3em
            margin-bottom: 0px
            i
                color: var(--button-primary)
    .panel-nav
        border-bottom: 1px solid #dbdade
        display: flex
        padding: 8px
        ul 
            display: flex
            list-style none
            overflow-x: scroll
            margin: 0px
            padding: 0px
            li
                margin-right: 8px
                button
                    display: flex
                    color: var(--button-primary)
                    font-size: 1em
                    padding: 9px 20px
                    text-decoration: none
                    i
                        margin-right: 4px
                    &:hover
                        color: var(--according-panel)
                button.active
                    background-color: var(--button-primary)
                    color: var(--label-white)
                    &:hover
                        background-color: var(--button-primary)
                        color: var(--label-white)
    .inside
        padding: 16px
        .img_transports
            display: flex
            margin: 0px
            padding: 0px
            width 100%
            justify-content: center
            a
                margin: 0px
                padding: 0px
                display: flex
                justify-content: center
                img
                    width 50%
        .form_search
            display: none
            margin-bottom: 16px
            .btn
                width 100%
                    
                
a.file_uploader_trigger
    align-items: center
    border: 1px dashed #e0e3fb !important
    border-radius: 12px
    color: var(--morado)
    display: flex
    justify-content: center
    height: 50px
    text-decoration: none
    transition: all 0.4 ease
    width: 100%
    .trigger_content
        display: flex
        img
            display: block
            width: 24px !important
        span
            color: #2a8df2
            font-size: 1em
            margin-top: 2px
            margin-left: 10px
    &:hover
        background-color: #f0f0f0
.nav-vertical
    button
        border-radius: 4px !important
        color: #626262 !important
        font-size: 1.1em
        padding: 10px 12px
        text-align: left
        i
            margin-right: 8px
    button.active
        background-color: var(--according-panel) !important
        color: var(--label-white) !important

.table-active
    background-color: #31C950
    border-radius:5px
    color: var(--label-white)
    padding: 5px

.table-inactive
    background-color: #C11007
    border-radius:5px
    color: var(--label-white)
    padding: 5px

.btn-generate
    background-color: #025891
    color: #fff
    padding: 5px
    border-radius: 4px
    margin-top: 30px
    &:hover
        background-color: #057faf
        color: #fff

.labels-preview
    width 100%
    background #eef1f5
    border-radius 8px
    padding 35px
    display flex
    justify-content center
    align-items flex-start
    overflow auto
    box-sizing border-box

.labels-page-preview
    width 210mm
    background #fff
    padding 12mm
    box-sizing border-box
    box-shadow 0 5px 25px rgba(0, 0, 0, .15)
    display flex
    flex-wrap wrap
    align-content flex-start
    gap 5mm
    position relative

.label-preview
    width 50mm
    height 30mm
    background #fff
    border 1px dashed #b8bec8
    box-sizing border-box
    padding 3mm
    display flex
    flex-direction column
    justify-content center
    align-items center
    text-align center
    overflow hidden

.label-company
    font-size 10px
    font-weight 700
    text-transform uppercase
    margin-bottom 2mm

.label-product
    width 100%
    font-size 11px
    font-weight 600
    text-transform uppercase
    line-height 1.2
    white-space nowrap
    overflow hidden
    text-overflow ellipsis

.label-barcode
    margin-top 2mm
    width 100%
    display flex
    justify-content center
    align-items center

.barcode-real
    display block
    width 90%
    max-width 45mm
    height 12mm

.print-labels
    display: flex
    justify-content: end
    .btn-printer-labels
        display: grid
        box-sizing: border-box
        background-color: var(--print-labels)
        border: 1px solid var(--print-labels)
        color: var(--label-white)
        font-size: 0.9375rem
        letter-spacing: .43px
        padding: 9px 12px
        margin-top: 16px
        transition: all .135s ease-in-out
        cursor: pointer
        text-align: center
        width 25%
        &:hover
            background-color: #0A76AD
            border: 1px solid #0A76AD

.meat-distribution
    .md-subtitle
        color #858b94
        font-size 13px
        margin 6px 0 0

    .md-summary
        display grid
        grid-template-columns repeat(4, minmax(0, 1fr))
        gap 16px
        margin-bottom 28px

    .md-summary-card
        display flex
        align-items center
        gap 13px
        padding 20px
        border 1px solid #e9ecef
        border-radius 12px
        background #fff
        min-width 0

        span
            display block
            color #7c8490
            font-size 12px
            margin-bottom 7px

        h3
            color #242b35
            font-size 23px
            font-weight 700
            margin 0

        small
            font-size 12px
            color #7c8490
            font-weight 500

    .md-summary-icon
        display flex
        align-items center
        justify-content center
        flex-shrink 0
        width 46px
        height 46px
        border-radius 12px
        background #f0f2f5
        color #505a68
        font-size 21px

    .md-icon-green
        color #20864c
        background #e9f7ee

    .md-icon-blue
        color #2768bb
        background #eaf2ff

    .md-icon-orange
        color #b66a12
        background #fff3df

    .md-section
        margin-top 30px

    .md-section-title
        display flex
        justify-content space-between
        align-items center
        gap 16px
        margin-bottom 18px

        h5
            font-size 16px
            font-weight 700
            color #252c36
            margin 0

            i
                margin-right 6px
                color #538265

        p
            font-size 13px
            color #858b94
            margin 6px 0 0

    .md-animal-selector
        padding 20px
        background #f8faf9
        border 1px solid #e8eee9
        border-radius 12px

    .md-field
        max-width 520px

        label
            display block
            font-size 13px
            font-weight 600
            color #424a55
            margin-bottom 8px

        .form-control
            width 100%
            min-height 44px
            border 1px solid #dfe3e8
            border-radius 8px
            background #fff
            padding 10px 12px
            box-shadow none

            &:focus
                border-color #629274
                outline none

    .md-animal-status
        display flex
        align-items center
        gap 8px
        color #6d7782
        font-size 12px
        margin-top 13px

    .md-animal-status i
        color #528567
        font-size 15px

    .md-products-heading
        margin-bottom 18px

    .md-products-count
        color #68727d
        background #f3f5f7
        padding 8px 12px
        border-radius 8px
        font-size 12px
        white-space nowrap

        i
            margin-right 5px

    .md-toolbar
        display grid
        grid-template-columns minmax(0, 1fr) 250px
        gap 12px
        margin-bottom 20px

    .md-search
        position relative

        > i
            position absolute
            left 14px
            top 50%
            transform translateY(-50%)
            color #89919c
            font-size 15px
            pointer-events none

        input
            width 100%
            height 44px
            padding 0 14px 0 40px
            border 1px solid #e0e4e9
            border-radius 9px
            background #fff
            outline none
            font-size 13px

            &:focus
                border-color #6b967a

    .md-filter .form-control
        height 44px
        width 100%
        padding 0 12px
        border 1px solid #e0e4e9
        border-radius 9px
        background #fff
        font-size 13px
        outline none

    .md-product-grid
        display grid
        grid-template-columns repeat(4, minmax(0, 1fr))
        gap 16px

    .md-product-card
        min-width 0
        overflow hidden
        border 1px solid #e7eaee
        border-radius 12px
        background #fff
        transition border-color .2s ease, box-shadow .2s ease, transform .2s ease

        &:hover
            border-color #bfd2c4
            box-shadow 0 5px 18px rgba(25, 45, 32, .07)
            transform translateY(-2px)

    .md-product-image
        position relative
        min-height 160px
        background-size cover
        background-position center
        background-repeat no-repeat
        border-radius 10px
        overflow hidden
        &::before
            content ''
            position absolute
            inset 0
            background linear-gradient(180deg, transparent 35%, rgba(0, 0, 0, .7) 100%)

    .md-product-category
        position absolute
        z-index 1
        bottom 10px
        left 10px
        color #fff
        background rgba(0, 0, 0, .55)
        padding 5px 9px
        border-radius 6px
        font-size 12px

    .md-product-info
        padding 14px

        h6
            color #252c36
            font-size 15px
            font-weight 700
            margin 0 0 7px

        p
            color #858b94
            font-size 11px
            margin 0 0 16px

            strong
                color #3e4852
                font-weight 600

        label
            display block
            color #68727d
            font-size 11px
            margin-bottom 7px

    .md-quantity-input
        display flex
        align-items center
        gap 8px
        border 1px solid #dfe4e8
        border-radius 8px
        padding 0 11px
        height 40px
        background #fff

        &:focus-within
            border-color #679276

        input
            width 100%
            min-width 0
            height 36px
            border 0
            outline none
            background transparent
            color #29332d
            font-size 14px
            font-weight 600

        span
            color #7c8490
            font-size 12px

    .md-no-products
        grid-column 1 / -1
        text-align center
        padding 45px 15px
        color #8a929b

        i
            font-size 30px

        p
            font-size 13px
            margin-top 10px

    .md-footer
        display flex
        align-items center
        justify-content space-between
        gap 20px
        margin-top 30px
        padding 20px
        border 1px solid #e1eae3
        border-radius 12px
        background #f7faf7

    .md-footer-info
        display flex
        align-items center
        gap 13px

        > div:last-child > span
            display block
            color #7a847d
            font-size 12px
            margin-bottom 4px

        h4
            color #285d3a
            font-size 22px
            font-weight 700
            margin 0

        p
            color #858b94
            font-size 11px
            margin 5px 0 0

    .md-footer-icon
        display flex
        align-items center
        justify-content center
        width 46px
        height 46px
        flex-shrink 0
        border-radius 12px
        background #e4f1e7
        color #39774d
        font-size 21px

    .md-btn-save
        display inline-flex
        align-items center
        justify-content center
        gap 8px
        min-height 44px
        padding 0 20px
        border 0
        border-radius 9px
        background #39764c
        color #fff
        font-size 13px
        font-weight 600
        transition background .2s ease
        white-space nowrap

        &:hover
            background #2d613d
            color #fff

        &:disabled
            opacity .55
            cursor not-allowed

@media screen and (max-width: 992px)
    .wrapper
        .sidebar
            left -270px
            position: absolute
            top: 0
        .content
            box-sizing: border-box
            padding: 14px
            width: 100%
        .list-card-profile-avatar
            .card
                flex-basis: auto
                width 100%
    .hide-in-desktop
        display: block
    
    .movil16
        margin-top: 16px

    .opts
        display: flex
    
@media screen and (max-width: 1280px)
    .mini-profile
        display: block
        .avatar
            margin-left: 60px
            width 64px
            margin-bottom: 5px
            img
                display: block
                border-radius: 10px
                width 100%

@media (max-width: 1100px)
    .meat-distribution
        .md-summary
            grid-template-columns repeat(2, minmax(0, 1fr))

        .md-product-grid
            grid-template-columns repeat(3, minmax(0, 1fr))
            

@media (max-width: 768px)
    .meat-distribution
        .md-toolbar
            grid-template-columns 1fr

        .md-product-grid
            grid-template-columns repeat(2, minmax(0, 1fr))

        .md-products-heading
            align-items flex-start
            flex-direction column

        .md-footer
            align-items stretch
            flex-direction column

        .md-btn-save
            width 100%
            

@media (max-width: 480px)
    .meat-distribution
        .md-summary
            grid-template-columns 1fr

        .md-summary-card
            padding 14px

        .md-product-grid
            gap 10px

        .md-product-image
            height 100px

        .md-product-info
            padding 10px

            h6
                font-size 13px

        .md-footer
            padding 14px
    