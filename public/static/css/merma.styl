
:root
  --merma-navy #0b1d35
  --merma-red #d71920
  --merma-red-dark #ac1119
  --merma-green #16833b
  --merma-text #14213d
  --merma-muted #536784
  --merma-border #e0e6ef
  --merma-bg #f2f4f8

.merma-app
  display flex
  flex-direction column
  gap 16px
  min-height calc(100vh - 70px)
  padding 14px 12px
  background var(--merma-bg)
  color var(--merma-text)
  font-family "Inter", "Segoe UI", Arial, sans-serif
  font-size 14px

  *
    box-sizing border-box

  button
  input
  select
    font inherit

.merma-header
  display flex
  align-items center
  justify-content space-between
  gap 20px

.merma-heading
  display flex
  align-items center
  gap 13px

  h1
    margin 0
    color var(--merma-navy)
    font-size 25px
    font-weight 800

  p
    margin 5px 0 0
    color var(--merma-muted)

.merma-heading-icon
  display grid
  place-items center
  width 48px
  height 48px
  border-radius 10px
  background var(--merma-red)
  color white
  font-size 25px

.merma-breadcrumb
  display flex
  align-items center
  flex-wrap wrap
  gap 10px
  color var(--merma-muted)

  a
    color #304967
    text-decoration none

  strong
    font-weight 500

/* Resumen superior */

.merma-summary
  display grid
  grid-template-columns minmax(0, 1fr) minmax(0, 1fr) minmax(280px, 1.3fr)
  gap 12px

.merma-summary-card
  display flex
  align-items center
  gap 12px
  min-height 78px
  padding 14px 18px
  border 1px solid #e9edf3
  border-radius 9px
  background white

.summary-animal
  font-size 34px

  &.pig
    color #e83356

  &.cow
    color var(--merma-red)

.summary-label
  display flex
  flex-direction column
  gap 4px
  flex 1
  color #344968
  line-height 1.3

.summary-number
  font-size 30px
  font-weight 800
  color var(--merma-navy)

.merma-warning
  display flex
  align-items center
  gap 12px
  padding 12px 16px
  border-radius 9px
  background #fbe7e9
  color #9f1720

  .warning-icon
    flex-shrink 0
    font-size 30px

  p
    margin 0
    line-height 1.55

/* Paneles */

.merma-workspace
  display grid
  grid-template-columns minmax(0, 1fr) minmax(0, 1.12fr) minmax(0, 1.05fr)
  gap 12px
  align-items stretch

.merma-panel
  min-width 0
  border 1px solid #e8edf4
  border-radius 9px
  background white
  box-shadow 0 3px 12px rgba(15, 35, 65, .035)

.animal-panel
.calculation-panel
.visualization-panel
  display flex
  flex-direction column
  gap 14px
  padding 16px

.merma-panel-heading
  display flex
  align-items center
  gap 12px
  margin-bottom 2px

  h2
    margin 0
    color var(--merma-navy)
    font-size 18px
    font-weight 800

  p
    margin 4px 0 0
    color var(--merma-muted)
    line-height 1.35

.panel-icon
  display grid
  place-items center
  flex-shrink 0
  width 34px
  height 38px
  color var(--merma-red-dark)
  font-size 29px
  font-weight 800

/* Campos */

.merma-field
  display flex
  flex-direction column
  gap 8px

  label
    font-weight 700
    color #1d2b43

  select
    width 100%
    min-height 44px
    padding 10px 12px
    border 1px solid #d5deeb
    border-radius 7px
    outline none
    background white
    color var(--merma-text)

    &:focus
      border-color #6689bd
      box-shadow 0 0 0 3px rgba(60, 110, 180, .1)

  small
    color var(--merma-muted)

/* Detalle del animal */

.animal-detail-card
  display flex
  flex-direction column
  gap 16px
  margin-top 8px
  padding 17px
  border-radius 8px
  background #f2f4f8

  h3
    display flex
    align-items center
    gap 10px
    margin 0 0 6px
    font-size 21px
    font-weight 800

.animal-detail-row
  display flex
  align-items center
  justify-content space-between
  flex-wrap wrap
  gap 8px

  > span:first-child
    color #344968

  strong
    font-weight 600

.merma-badge
  display inline-flex
  align-items center
  justify-content center
  padding 5px 10px
  border 1px solid #ffd36a
  border-radius 7px
  background #fff0bf
  color #8c4300
  font-size 12px
  font-weight 600

/* Métricas de peso */

.merma-metric
  display flex
  align-items center
  gap 10px
  min-height 62px
  padding 12px
  border-radius 7px

  > strong
    flex 1
    font-size 13px
    line-height 1.4

  output
    font-size clamp(19px, 1.8vw, 28px)
    font-weight 800
    white-space nowrap

  .metric-icon
    flex-shrink 0
    font-size 24px

  &.live
    background #fbe8eb

    output
      color #111827

  &.loss
    background #fff2d7

    output
      color #a25700

  &.final
    background #d9f3e1

    output
      color #11823b

/* Porcentaje */

.percentage-input
  display flex
  min-height 44px
  overflow hidden
  border 1px solid #d5deeb
  border-radius 7px

  input
    width 100%
    min-width 0
    padding 10px 12px
    border 0
    outline none
    background white
    color var(--merma-text)

  > span
    display grid
    place-items center
    min-width 48px
    border-left 1px solid #d5deeb
    background #edf1f7
    font-weight 800

.percentage-presets
  display flex
  flex-wrap wrap
  gap 8px

  button
    min-width 70px
    padding 9px 12px
    border 1px solid #dce3ed
    border-radius 6px
    background #f0f3f8
    color #263a59
    cursor pointer

    &:hover
    &.active
      border-color var(--merma-red)
      background var(--merma-red)
      color white

  .other-percent
    min-width 80px

.btn-save-merma
  display flex
  align-items center
  justify-content center
  gap 9px
  width 100%
  min-height 48px
  margin-top auto
  padding 12px
  border 0
  border-radius 7px
  background var(--merma-red)
  color white
  font-size 16px
  font-weight 800
  cursor pointer
  transition background .15s

  &:hover
    background var(--merma-red-dark)

/* Visualización */

.weight-visual-card
  display grid
  grid-template-columns 42px minmax(0, 1fr) auto
  align-items center
  gap 10px
  padding 13px 12px
  border-radius 8px
  background #f2f4f8

  > b
    align-self end
    padding-bottom 4px
    font-size 12px
    white-space nowrap

.weight-visual-icon
  font-size 29px

.weight-visual-content
  min-width 0

  > strong
    display block
    font-size 13px

  h3
    margin 5px 0 8px
    font-size 18px
    font-weight 800

.weight-bar
  width 100%
  height 15px
  overflow hidden
  border-radius 20px
  background #d9dee7

  span
    display block
    height 100%
    border-radius inherit
    transition width .2s ease

.bar-live
  width 100%
  background #a90f19

.bar-loss
  width 25%
  background #f29aab

.bar-final
  width 75%
  background #28a653

.loss-icon
  color #ef4266

.final-icon
  color var(--merma-green)

.merma-info
  display flex
  align-items flex-start
  gap 10px
  margin-top 2px
  padding 13px
  border-radius 7px
  background #e4f0ff
  color #244a7b

  > span
    flex-shrink 0
    font-size 20px

  p
    margin 0
    font-size 12px
    line-height 1.6

/* Tabla de pendientes */

.pending-panel
  overflow hidden

.pending-heading
  display flex
  align-items center
  gap 10px
  padding 15px 17px
  border-bottom 1px solid var(--merma-border)

  > span
    color var(--merma-red)
    font-size 25px

  h2
    margin 0
    font-size 18px
    font-weight 800

.pending-table-wrapper
  overflow-x auto
  padding 0 14px 14px

.pending-table
  width 100%
  border-collapse collapse
  white-space nowrap

  th
  td
    padding 13px 12px
    border-bottom 1px solid #e1e7ef
    text-align left

  th
    background #f0f3f8
    color #344968
    font-size 12px
    font-weight 800

  td
    font-size 13px

.btn-select-animal
  padding 8px 12px
  border 1px solid var(--merma-red)
  border-radius 6px
  background white
  color var(--merma-red)
  font-weight 700
  cursor pointer

  &:hover
    background var(--merma-red)
    color white

/* Adaptación a pantallas medianas */

@media (max-width: 1250px)
  .merma-summary
    grid-template-columns repeat(2, minmax(0, 1fr))

  .merma-warning
    grid-column 1 / -1

  .merma-workspace
    grid-template-columns repeat(2, minmax(0, 1fr))

  .visualization-panel
    grid-column 1 / -1

@media (max-width: 760px)
  .merma-header
    align-items flex-start
    flex-direction column

  .merma-heading
    align-items flex-start

    h1
      font-size 22px

  .merma-summary
  .merma-workspace
    grid-template-columns minmax(0, 1fr)

  .merma-warning
  .visualization-panel
    grid-column auto

  .merma-summary-card
    padding 12px

  .merma-panel-heading h2
    font-size 17px

  .merma-metric
    flex-wrap wrap

    output
      font-size 22px

  .animal-detail-card
    padding 13px

  .weight-visual-card
    grid-template-columns 35px minmax(0, 1fr) auto

  .pending-table-wrapper
    padding 0 8px 10px
