
/* =========================================
   HISTORIAL DE VENTAS
========================================= */

.sales-container {
    width: 100%;
    padding: 24px;
    color: #252c35;
}

/* ENCABEZADO */

.sales-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 25px;
}

.sales-header h1 {
    margin: 0;
    font-size: 26px;
    font-weight: 750;
    color: #252c35;
}

.sales-header p {
    margin: 6px 0 0;
    color: #7a8694;
    font-size: 14px;
}

.sales-header-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: #eaf1fa;
    color: #2a5d9f;
    font-size: 22px;
}

/* RESUMEN */

.sales-summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 22px;
}

.sales-summary-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 21px;
    background: #fff;
    border: 1px solid #e9edf2;
    border-radius: 12px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, .035);
}

.sales-summary-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    font-size: 19px;
}

.sales-icon-blue {
    background: #eaf1fa;
    color: #2a5d9f;
}

.sales-icon-green {
    background: #e7f7ee;
    color: #23965a;
}

.sales-summary-card span {
    display: block;
    color: #7a8694;
    font-size: 13px;
    margin-bottom: 5px;
}

.sales-summary-card h3 {
    margin: 0;
    font-size: 23px;
    font-weight: 750;
    color: #252c35;
}

/* PANELES */

.sales-panel {
    background: #fff;
    border: 1px solid #e9edf2;
    border-radius: 12px;
    margin-bottom: 22px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, .035);
    overflow: hidden;
}

.sales-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 22px;
    border-bottom: 1px solid #edf0f4;
}

.sales-panel-header h2 {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: #252c35;
}

.sales-panel-header h2 i {
    color: #2a5d9f;
    margin-right: 7px;
}

.sales-panel-header p {
    margin: 5px 0 0;
    color: #89939f;
    font-size: 12px;
}

/* FILTROS */

.sales-filters {
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 15px;
    padding: 22px;
}

.sales-filter-group {
    flex: 1;
    min-width: 160px;
}

.sales-filter-folio {
    flex: 1.5;
}

.sales-filter-group label {
    display: block;
    margin-bottom: 8px;
    color: #4c5662;
    font-size: 12px;
    font-weight: 650;
}

.sales-filter-group input {
    width: 100%;
    height: 42px;
    padding: 0 12px;
    border: 1px solid #dfe4eb;
    border-radius: 7px;
    outline: none;
    color: #252c35;
    background: #fff;
    font-size: 13px;
    transition: border-color .2s, box-shadow .2s;
}

.sales-filter-group input:focus {
    border-color: #2a5d9f;
    box-shadow: 0 0 0 3px rgba(42, 93, 159, .10);
}

.sales-input-icon {
    position: relative;
}

.sales-input-icon i {
    position: absolute;
    left: 12px;
    top: 14px;
    color: #89939f;
    font-size: 13px;
}

.sales-input-icon input {
    padding-left: 35px;
}

.sales-filter-actions {
    display: flex;
    gap: 8px;
}

.btn-sales-search,
.btn-sales-clear {
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 15px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 650;
    text-decoration: none;
    cursor: pointer;
    transition: .2s;
}

.btn-sales-search {
    border: 1px solid #2a5d9f;
    background: #2a5d9f;
    color: #fff;
}

.btn-sales-search:hover {
    background: #214b80;
}

.btn-sales-clear {
    border: 1px solid #dfe4eb;
    background: #fff;
    color: #5f6975;
}

.btn-sales-clear:hover {
    background: #f3f5f8;
}

/* TABLA */

.sales-table-wrapper {
    width: 100%;
    overflow-x: auto;
}

.sales-table {
    width: 100%;
    border-collapse: collapse;
    white-space: nowrap;
}

.sales-table thead {
    background: #f7f9fb;
}

.sales-table th {
    padding: 14px 16px;
    color: #707b88;
    font-size: 11px;
    font-weight: 700;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: .35px;
}

.sales-table td {
    padding: 15px 16px;
    border-top: 1px solid #edf0f4;
    color: #495461;
    font-size: 12px;
}

.sales-table tbody tr {
    transition: background .15s;
}

.sales-table tbody tr:hover {
    background: #fafbfd;
}

.sales-folio {
    color: #2a5d9f;
    font-weight: 750;
}

.sales-date {
    color: #343e49;
    font-weight: 650;
}

.sales-time {
    display: block;
    margin-top: 3px;
    color: #89939f;
    font-size: 11px;
}

.sales-total {
    color: #252c35;
    font-size: 13px;
}

/* ESTADOS */

.sales-status {
    display: inline-block;
    padding: 5px 9px;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 700;
}

.status-completed {
    color: #218653;
    background: #e7f7ee;
}

.status-other {
    color: #9a6a20;
    background: #fff3dc;
}

/* ACCIONES */

.sales-actions {
    display: flex;
    align-items: center;
    gap: 7px;
}

.btn-sales-view,
.btn-sales-print {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 7px;
    cursor: pointer;
    transition: .2s;
}

.btn-sales-view {
    background: #eaf1fa;
    color: #2a5d9f;
}

.btn-sales-view:hover {
    background: #d8e6f8;
}

.btn-sales-print {
    background: #e7f7ee;
    color: #23965a;
}

.btn-sales-print:hover {
    background: #d2f0df;
}

/* VACÍO */

.sales-empty {
    padding: 45px 20px;
    text-align: center;
}

.sales-empty > i {
    color: #b7c0ca;
    font-size: 35px;
    margin-bottom: 12px;
}

.sales-empty h3 {
    margin: 0;
    color: #46515d;
    font-size: 15px;
}

.sales-empty p {
    margin: 7px 0 0;
    color: #929ca7;
    font-size: 12px;
}

/* RESULTADOS Y PAGINACIÓN */

.sales-results-count {
    padding: 6px 10px;
    border-radius: 20px;
    background: #eaf1fa;
    color: #2a5d9f;
    font-size: 11px;
    font-weight: 700;
}

.sales-pagination {
    padding: 18px 22px;
    border-top: 1px solid #edf0f4;
}


/* MODAL DETALLE DE VENTA */

.sales-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(20, 28, 38, .60);
}

.sales-modal-overlay.active {
    display: flex;
}

.sales-detail-modal {
    width: 100%;
    max-width: 850px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 13px;
    overflow: hidden;
    box-shadow: 0 15px 50px rgba(0, 0, 0, .20);
}

.sales-detail-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid #edf0f4;
}

.sales-detail-header h2 {
    margin: 0;
    color: #252c35;
    font-size: 18px;
}

.sales-detail-header h2 i {
    color: #2a5d9f;
    margin-right: 7px;
}

.sales-detail-header p {
    margin: 5px 0 0;
    color: #7a8694;
    font-size: 12px;
}

.sales-detail-header button {
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 7px;
    background: #f1f3f6;
    color: #606b78;
    font-size: 25px;
    cursor: pointer;
}

.sales-detail-body {
    padding: 22px 24px;
    overflow-y: auto;
}

.sales-detail-info {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    padding-bottom: 22px;
    border-bottom: 1px solid #edf0f4;
}

.sales-detail-info span,
.sales-detail-totals span {
    display: block;
    margin-bottom: 5px;
    color: #87919d;
    font-size: 11px;
}

.sales-detail-info strong {
    color: #333e49;
    font-size: 13px;
}

.sales-detail-products {
    margin-top: 22px;
}

.sales-detail-products h3 {
    margin: 0 0 14px;
    color: #252c35;
    font-size: 15px;
}

.sales-detail-table-wrapper {
    overflow-x: auto;
}

.sales-detail-table {
    width: 100%;
    border-collapse: collapse;
    white-space: nowrap;
}

.sales-detail-table th {
    padding: 12px;
    background: #f7f9fb;
    color: #707b88;
    text-align: left;
    font-size: 10px;
    text-transform: uppercase;
}

.sales-detail-table td {
    padding: 13px 12px;
    border-bottom: 1px solid #edf0f4;
    color: #495461;
    font-size: 12px;
}

.sales-detail-table td strong {
    color: #333e49;
}

.sales-detail-table td small {
    color: #89939f;
    font-size: 10px;
}

.sales-detail-totals {
    max-width: 330px;
    margin: 22px 0 0 auto;
}

.sales-detail-totals > div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
}

.sales-detail-totals strong {
    color: #343e49;
    font-size: 13px;
}

.sales-detail-totals .sales-detail-grand-total {
    margin: 7px 0;
    padding: 13px 12px;
    border-radius: 8px;
    background: #eaf1fa;
}

.sales-detail-grand-total span,
.sales-detail-grand-total strong {
    color: #2a5d9f;
    font-size: 16px;
    font-weight: 750;
}

.sales-detail-loading,
.sales-detail-error {
    padding: 40px 15px;
    text-align: center;
    color: #7a8694;
    font-size: 13px;
}

.sales-detail-loading i {
    margin-right: 8px;
    color: #2a5d9f;
}

.sales-detail-error {
    color: #c0392b;
}

.sales-detail-footer {
    display: flex;
    justify-content: flex-end;
    padding: 15px 24px;
    border-top: 1px solid #edf0f4;
}

.sales-detail-footer button {
    padding: 10px 22px;
    border: 0;
    border-radius: 7px;
    background: #2a5d9f;
    color: #fff;
    font-size: 12px;
    font-weight: 650;
    cursor: pointer;
}


/* RESPONSIVE */

@media (max-width: 768px) {
    .sales-container {
        padding: 14px;
    }

    .sales-summary {
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .sales-filters {
        flex-direction: column;
        align-items: stretch;
    }

    .sales-filter-group {
        width: 100%;
    }

    .sales-filter-actions {
        width: 100%;
    }

    .btn-sales-search,
    .btn-sales-clear {
        flex: 1;
    }

    .sales-header h1 {
        font-size: 21px;
    }

    .sales-panel-header {
        padding: 16px;
    }

        .sales-modal-overlay {
        padding: 10px;
    }

    .sales-detail-modal {
        max-height: 95vh;
    }

    .sales-detail-info {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sales-detail-header,
    .sales-detail-body {
        padding: 16px;
    }
}
