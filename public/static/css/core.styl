:root{
    --button-primary: #B91C1C
    --button-primary-hover: #991B1B;
    --label-white: #FFF
    --background-white: #FFF
    --background-black: #000
    --label-gray: #6f6e72
    --according-panel: #c85d05
    --label-black: #000000
}

*
    margin: 0px
    padding: 0px
    -webkit-touch-callout: none !important
    -webkit-user-drag: none
    transition: all 0.2s ease
    &::-webkit-scrollbar
        display: none

.ts
    -webkit-transition: all 0.3s ease
    transition: all 0.3s ease

.mtop4
    margin-top: 4px

.mtop8
    margin-top: 8px

.mtop16
    margin-top: 16px

.mtop24
    margin-top: 24px

.mtop32
    margin-top: 32px


.sh
    box-shadow: 0 0.25rem 1.125rem rgba(75, 70, 92, 0.2)
    -webkit-box-shadow: 0 0.25rem 1.125rem rgba(75, 70, 92, 0.2)
    -moz-box-shadow: 0 0.25rem 1.125rem rgba(75, 70, 92, 0.2)

.form-control
.form-select
.form-date
    &:focus
        box-shadow: none
        outline: none
.form-select
    &:focus
        border: 1px solid var(--button-primary)
.form
    label
        color: var(--label-gray)
        display: flex
        font-size: 0.88rem
        margin-bottom: 6px
        width: 100%
    input 
        box-sizing: border-box
        border: 1px solid #dbdade
        border-radius: .375rem
        color: #6f6b7d
        font-size: 0.9375rem
        padding: 9px 12px
        width: 100%
        &:focus
        &:active
            outline: none
        &:focus
            border: 1px solid var(--button-primary)
    input[type=submit]
        display: grid
        box-sizing: border-box
        background-color: var(--button-primary)
        border: 1px solid var(--button-primary)
        color: var(--blanco)
        font-size: 0.9375rem
        letter-spacing: .43px
        padding: 9px 12px
        transition: all .135s ease-in-out
        cursor: pointer
        text-align: center
        width: 100%
        &:hover
            background-color: var(--button-primary-hover)
            border: 1px solid var(--button-primary-hover)
    button[type=submit]
        display: grid
        box-sizing: border-box
        background-color: var(--button-primary)
        border: 1px solid var(--button-primary)
        color: var(--label-white)
        font-size: 0.9375rem
        letter-spacing: .43px
        padding: 9px 12px
        transition: all .135s ease-in-out
        cursor: pointer
        text-align: center
        width: 100%
        &:hover
            background-color: var(--button-primary-hover)
            border: 1px solid var(--button-primary-hover)
    .actions_right
        display: flex
        justify-content: right 
        a
            font-weight: 400
.form-check
    .form-check-input
        &:checked
            background-color: var(--button-primary)
            border-color: var(--button-primary)
        &:focus
            box-shadow: none
            outline: none
.loader_action
    align-items: center
    display: none
    background-color: rgba(0,0,0, .5)
    justify-content: center
    height: 100vh
    position: fixed
    width: 100%
    z-index: 999990
    .action
        align-items: center
        display: flex
        background-color: #7A1111
        border-radius: 8px
        box-sizing: border-box
        justify-content: center
        padding: 16px
        overflow: hidden
        width: 330px
        .col
            display: block
            flex: initial
            color: var(--label-white)
            float: left
            &:first-child
                width: 40px
                img
                    display: block
                    width: 100%
            &:last-child
                margin-left: 5%
                position: relative
                width: calc(95% - 40px)

.loader_action_animation_show
    animation-timing-function: ease-in-out
    animation: action_show 0.3s forwards

.loader_action_animation_hide
    animation-timing-function: ease-in-out
    animation: action_hide 0.3s forwards

.align-center
    display: flex
    justify-content: center

.hide
    display: none !important

.pulse-element
    animation: pulse 0.5s infinite
    transform-origin: center

@keyframes pulse {
    0% {
       transform: scale(1) 
    }
    50% {
        transform: scale(1.4)  
    }
    100% {
        transform: scale(1)    
    }
}

.modal
  .modal-dialog
    transition transform .3s ease
    max-width 550px
  .modal-content
    border 0
    border-radius 18px
    overflow hidden
    background #fff
    box-shadow 0 20px 60px rgba(0, 0, 0, .20)
    border 1px solid rgba(255, 255, 255, .2)
    backdrop-filter blur(10px)
  .modal-header
    padding 20px 24px
    border 0
    background linear-gradient(135deg, #1e293b, #334155)
    color #fff
    .modal-title
      font-size 19px
      font-weight 600
      letter-spacing .2px
    .btn-close
      filter brightness(0) invert(1)
      opacity .8
      transition all .2s ease

      &:hover
        opacity 1
        transform rotate(90deg)
  .modal-body
    padding 28px 24px
    background #fff
    color #475569
    font-size 15px
    line-height 1.6

  .modal-footer
    padding 16px 24px
    border-top 1px solid #e2e8f0
    background #f8fafc
    gap 10px

    .btn
      border-radius 10px
      padding 9px 18px
      font-size 14px
      font-weight 600
      transition all .2s ease

      &:hover
        transform translateY(-1px)

    .btn-secondary
      background #e2e8f0
      border 0
      color #475569

      &:hover
        background #cbd5e1
        color #1e293b

    .btn-primary
      background #0c3898
      border 0
      color #fff
      box-shadow 0 4px 12px rgba(37, 99, 235, .25)

      &:hover
        background #0c3898
        box-shadow 0 6px 16px rgba(37, 99, 235, .35)

  &.show
    .modal-dialog
      transform scale(1)

.modal-backdrop
  background #0f172a

  &.show
    opacity .65

@keyframes action_show {
    0% {
       opacity 0 
    }
    100% {
        opacity 1    
    }
}

@keyframes action_hide {
    0% {
       opacity 1
    }
    100% {
        opacity 0   
    }
}